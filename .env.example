# Copy to .env and adjust. Every value has a sane default; nothing private is hardcoded.

# Port the dashboard listens on (loopback only)
PORT=4310

# Where Dockmaster keeps settings, profiles, logs, and history
#DOCKMASTER_DATA_DIR=~/.dockmaster

# Root directory the repo scanner walks
#DOCKMASTER_DEV_ROOT=~/Developer

# How deep below DEV_ROOT to look for repositories
#DOCKMASTER_WALK_DEPTH=3

# How often the logbook samples the frontmost app while tracking is on (ms)
#DOCKMASTER_LOGBOOK_INTERVAL_MS=10000
