{
  "name": "dockmaster",
  "version": "0.2.0",
  "private": true,
  "description": "Local dev dashboard: ports, repos, worktrees, health, hosts, processes, secrets, logbook",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "agent:install": "node scripts/agent.mjs install",
    "agent:uninstall": "node scripts/agent.mjs uninstall"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
