#!/usr/bin/python3 -I
"""Optional root-owned helper. No path, command, or privilege parameters accepted."""
import hashlib
import json
import os
import stat
import sys
import tempfile
import time
import fcntl
import subprocess

HOSTS = "/private/etc/hosts"
STATE = "/var/db/dockmaster"
MAX_BYTES = 262144


def validate(request):
    if not isinstance(request, dict) or set(request) != {"expected", "content"}:
        raise ValueError("invalid request")
    content, expected = request["content"], request["expected"]
    if not isinstance(content, str) or len(content.encode()) > MAX_BYTES or "\0" in content:
        raise ValueError("invalid content")
    if not isinstance(expected, str) or len(expected) != 64 or any(c not in "0123456789abcdef" for c in expected):
        raise ValueError("invalid digest")
    if not any(line.split()[:1] == ["127.0.0.1"] and "localhost" in line.split("#", 1)[0].split()[1:] for line in content.splitlines()):
        raise ValueError("localhost mapping is required")
    return content.encode(), expected


def apply(content, expected, hosts=HOSTS, state=STATE):
    # Production calls use only fixed paths; arguments exist for isolated tests.
    os.makedirs(state, mode=0o700, exist_ok=True)
    st = os.lstat(state)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid() or st.st_mode & 0o022:
        raise ValueError("unsafe state directory")
    lock = os.open(os.path.join(state, "hosts.lock"), os.O_CREAT | os.O_RDWR | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        fd = os.open(hosts, os.O_RDONLY | os.O_NOFOLLOW)
        with os.fdopen(fd, "rb") as source:
            original = source.read(MAX_BYTES + 1)
            current = os.fstat(source.fileno())
        if not stat.S_ISREG(current.st_mode) or current.st_uid != os.geteuid() or len(original) > MAX_BYTES:
            raise ValueError("unsafe hosts file")
        if hashlib.sha256(original).hexdigest() != expected:
            return False
        backup = os.open(os.path.join(state, "hosts-" + str(time.time_ns()) + ".backup"), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        with os.fdopen(backup, "wb") as output:
            output.write(original)
        fd, staged = tempfile.mkstemp(prefix="hosts.dockmaster.", dir=os.path.dirname(hosts))
        try:
            with os.fdopen(fd, "wb") as output:
                output.write(content)
                output.flush()
                os.fsync(output.fileno())
                os.fchmod(output.fileno(), 0o644)
            # Refuse edits made since the initial read, including external writers.
            with open(hosts, "rb") as current_file:
                if hashlib.sha256(current_file.read(MAX_BYTES + 1)).hexdigest() != expected:
                    return False
            os.replace(staged, hosts)
        finally:
            if os.path.exists(staged):
                os.unlink(staged)
        return True
    finally:
        os.close(lock)


def main():
    if os.geteuid() != 0 or len(sys.argv) != 1:
        return 11
    content, expected = validate(json.loads(sys.stdin.buffer.read(MAX_BYTES * 2 + 1)))
    if not apply(content, expected):
        return 10
    for args in (["/usr/bin/dscacheutil", "-flushcache"], ["/usr/bin/killall", "-HUP", "mDNSResponder"]):
        subprocess.run(args, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=3)
    return 0

if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(11)
